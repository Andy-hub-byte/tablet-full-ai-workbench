# ============================================================================
# Open WebUI 环境变量配置模板
# ----------------------------------------------------------------------------
# 用法：由 install.sh 自动复制为 /root/workbench/.env 并加载
#       手动修改后需重启服务：bash scripts/stop.sh && bash scripts/start.sh
# ============================================================================

#------------------------------------------------------------------------------ 网络与端口
PORT=8080                       # Open WebUI 监听端口
HOST=0.0.0.0                    # 监听所有网卡：同一 Wi-Fi 下其他设备可访问（多人房间需要）
# WEBUI_URL=http://192.168.x.x:8080   # 可选：平板在局域网中的访问地址（用于生成分享链接）

#------------------------------------------------------------------------------ 账号与安全
WEBUI_AUTH=True                 # 开启登录认证（多用户/多人房间必须）
ENABLE_SIGNUP=False             # 关闭公开注册：账号统一由管理员在后台创建，更安全
WEBUI_NAME=平板AI工作台         # 网页标题

#------------------------------------------------------------------------------ Ollama 连接
OLLAMA_BASE_URL=http://127.0.0.1:11434   # Termux 原生 Ollama 服务地址
ENABLE_OLLAMA_API=True

#------------------------------------------------------------------------------ 功能开关
RAG_EMBEDDING_ENGINE=ollama     # 知识库检索用 Ollama 嵌入模型，避免额外下载模型文件
ENABLE_COMMUNITY_SHARING=False  # 关闭社区分享（本地私有工作台）
ENABLE_MESSAGE_RATING=True      # 开启消息点赞/点踩

#------------------------------------------------------------------------------ 代码编辑器 Code Studio
EDITOR_PORT=8899                # 代码编辑器端口
# EDITOR_HOST=127.0.0.1         # 默认仅本机访问；改为 0.0.0.0 可开放局域网（谨慎）
# OWUI_TOKEN=                   # 可选：编辑器调用 AI 生成/解释功能所需的 API Key
                               # 获取方式：Open WebUI → 设置 → 账号 → API Keys
